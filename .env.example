DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tasks
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key

# --- POST /tasks/triage --------------------------------------------------
# OpenRouter (hosted, free tier): base URL below, key from openrouter.ai/keys,
# model "openrouter/free". Swap to Ollama (local) by changing only these
# three values: LLM_BASE_URL=http://localhost:11434/v1/, LLM_API_KEY=ollama,
# LLM_MODEL=gemma3:1b (or any model you've pulled).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key
LLM_MODEL=openrouter/free
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# LLM_STUB=1 skips the model entirely and returns a fixed, schema-valid
# response — used while developing, so restarting the server never spends
# a call. Real answers require this to be unset (or "0").
LLM_STUB=0
# LLM_ENABLED=false is the kill switch: skip the model, return a safe
# deterministic fallback instead. Defaults to true.
LLM_ENABLED=true
